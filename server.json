{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.EvannZhongg/browser-attach",
  "title": "BrowserAttach",
  "description": "Control existing signed-in Chrome and Edge tabs through a locally paired extension.",
  "version": "0.25.2",
  "repository": {
    "url": "https://github.com/EvannZhongg/BrowserAttach",
    "source": "github"
  },
  "websiteUrl": "https://github.com/EvannZhongg/BrowserAttach#readme",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@evan_zhong/browser-attach",
      "version": "0.25.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
