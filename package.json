{
  "name": "@evan_zhong/browser-attach",
  "version": "0.27.0",
  "mcpName": "io.github.EvannZhongg/browser-attach",
  "description": "MCP for existing signed-in Chrome and Edge tabs through a locally paired extension",
  "type": "module",
  "license": "MIT",
  "bin": {
    "browser-attach": "bin/browser-attach.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvannZhongg/BrowserAttach.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "extension/",
    "scripts/check-package.mjs",
    "README.md",
    "CONTRIBUTING.md",
    "docs/",
    "skills/",
    "mcp-config.json",
    "server.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "test:interaction": "node scripts/interaction-smoke.mjs",
    "test:upgrade": "node scripts/upgrade-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "prepack": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "homepage": "https://github.com/EvannZhongg/BrowserAttach#readme",
  "bugs": {
    "url": "https://github.com/EvannZhongg/BrowserAttach/issues"
  },
  "keywords": [
    "mcp",
    "chrome",
    "edge",
    "browser",
    "automation",
    "browser-attach"
  ]
}
