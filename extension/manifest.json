{
  "manifest_version": 3,
  "name": "BrowserAttach",
  "version": "0.26.0",
  "description": "Connect existing Chrome and Edge tabs to a locally paired MCP client.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrowserAttach",
    "default_icon": {
      "16": "icons/BrowserAttach.png",
      "32": "icons/BrowserAttach.png"
    }
  },
  "options_page": "options.html",
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:47831"
  },
  "icons": {
    "128": "icons/BrowserAttach.png"
  }
}
